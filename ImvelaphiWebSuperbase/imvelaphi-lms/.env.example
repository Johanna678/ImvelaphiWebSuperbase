NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:3000

# Supabase / Postgres Database
# Get this from Supabase: Project Settings -> Database -> Connection string -> URI
# (use the "Transaction pooler" or "Session pooler" version, not "Direct connection")
DATABASE_URL=postgresql://postgres.xxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# JWT Authentication
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=7d

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# AI chat widget (optional) — without a key the chat box still works,
# using built-in canned answers instead of a live model.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-4-6
